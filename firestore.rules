rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isManager() { return signedIn() && (role() == 'manager' || role() == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaveTypes/{typeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaveBalances/{balanceId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow write: if false; // Only Cloud Functions (Admin SDK)
    }

    match /leaveRequests/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager() || resource.data.status == 'approved');
      allow create: if signedIn() 
        && request.resource.data.uid == request.auth.uid 
        && request.resource.data.status == 'pending';
      allow update, delete: if false; // Only Cloud Functions (Admin SDK)
    }

    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow write: if false; // Only Cloud Functions
    }

    match /regularizations/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isManager());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if false; // Only Cloud Functions
    }

    match /holidays/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/company {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }
  }
}
