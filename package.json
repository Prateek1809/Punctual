{
  "name": "punctual-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:functions": "npm --prefix functions run build",
    "build:all": "npm run build && npm run build:functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm run build:functions && firebase deploy --only functions",
    "deploy": "npm run build && npm run build:functions && firebase deploy",
    "deploy:fn": "node scripts/deploy-fn.js",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:firestore": "firebase deploy --only firestore",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fullcalendar/angular": "^7.1.3",
    "@fullcalendar/core": "^7.1.3",
    "@fullcalendar/daygrid": "^6.1.22",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.6.2",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
